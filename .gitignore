# 설치된 외부 라이브러리 (npm install 하면 다시 생김)
/node_modules

# 빌드 결과물 (코드에서 자동으로 만들어지는 파일)
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# 비밀키가 들어있는 파일 — 절대 깃에 올리면 안 됨
.env
.env.local
.env*.local
*.pem

# 배포 관련 임시 파일
.vercel

# Supabase 로컬 작업 임시 파일
supabase/.temp
supabase/.branches

# 에러 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 테스트 결과
/coverage

# 편집기 개인 설정
.vscode/
.idea/

# 운영체제가 자동으로 만드는 파일
.DS_Store
Thumbs.db
desktop.ini
